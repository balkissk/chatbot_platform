ENVIRONMENT=development

# Option A: provide DATABASE_URL directly.
# If DATABASE_URL is set, it is used as-is.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/chatbot_db?sslmode=require

# Option B: omit DATABASE_URL and use PostgreSQL parts.
# development normally uses localhost + sslmode=disable.
# production normally uses Azure PostgreSQL + sslmode=require.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_SSLMODE=disable

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
FRONTEND_BASE_URL=https://your-frontend.azurewebsites.net
BACKEND_BASE_URL=https://your-backend.azurewebsites.net
FRONTEND_URL=https://your-frontend.azurewebsites.net
ALLOWED_ORIGINS=https://your-frontend.azurewebsites.net
API_BASE_URL=https://your-backend.azurewebsites.net
PUBLIC_API_BASE_URL=https://your-backend.azurewebsites.net

AI_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://balkissekri-7560-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=1536

# AZURE_OPENAI_ENDPOINT must be the resource endpoint only.
# Do not include /openai, /deployments, or a model path.
